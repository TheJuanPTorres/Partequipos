# =========================================================================
# Partequipos.com — Variables de entorno (plantilla)
# Copia este archivo a `.env.local` y rellena los valores reales.
# NUNCA subas `.env.local` ni secretos reales al repositorio (CLAUDE.md §8).
# =========================================================================

# --- Base de datos: PostgreSQL (Neon) -----------------------------------
# Cadena de conexión de Neon. Payload usa DATABASE_URI.
# IMPORTANTE: usar la cadena POOLED (el host contiene `-pooler`, p. ej.
# ...-pooler.<region>.aws.neon.tech). NO la conexión directa: Payload/Drizzle
# usa un pool y en serverless la directa satura los límites de conexión.
# Formato: postgresql://usuario:password@host-pooler.region.aws.neon.tech/db?sslmode=require
DATABASE_URI=

# --- Payload CMS --------------------------------------------------------
# Secreto usado por Payload para firmar tokens. Cadena aleatoria larga.
PAYLOAD_SECRET=

# --- URL pública del sitio ----------------------------------------------
# Base absoluta del sitio; usada para canonical, sitemap, Open Graph (SEO).
# En local: http://localhost:3000
NEXT_PUBLIC_SERVER_URL=

# --- Indexación por buscadores ------------------------------------------
# "true" abre el sitio a Google. CUALQUIER otro valor (o vacío) lo BLOQUEA:
# noindex en la metadata, X-Robots-Tag en la cabecera y Disallow total en
# robots.txt. Mientras el sitio real siga en WordPress esto debe quedar vacío,
# para no competir como contenido duplicado. Ver README §7.
NEXT_PUBLIC_PERMITIR_INDEXACION=

# --- Almacenamiento de archivos: Vercel Blob ----------------------------
# Token de lectura/escritura de Vercel Blob (o credenciales de Cloudflare R2).
BLOB_READ_WRITE_TOKEN=

# --- Monitoreo de errores: Sentry ---------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Protección de formularios: Cloudflare Turnstile --------------------
# Mientras estén VACÍAS se usan las claves de PRUEBA de Cloudflare, que
# aceptan cualquier token: los formularios funcionan pero NO están protegidos.
# Al recibir las claves reales del cliente basta rellenarlas aquí; no hay que
# tocar código. Ver src/lib/turnstile.ts.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Correo saliente: Resend --------------------------------------------
# Clave de API de Resend (https://resend.com/api-keys).
# SI SE DEJA VACÍA el sitio sigue funcionando: las solicitudes se guardan
# igual y solo se registra en el log que no se pudo avisar. Una caída del
# correo NO puede costar un lead. Ver README §8.
RESEND_API_KEY=

# Remitente. Resend exige que el dominio esté verificado en la cuenta;
# usar una dirección de un dominio sin verificar hace fallar el envío.
# Ejemplo: notificaciones@partequipos.com
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=

# Destinatario del aviso de solicitud nueva. Si se deja vacío se usa
# seoConfig.contact.email.
SOLICITUDES_EMAIL_TO=
