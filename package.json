{
  "name": "partequipos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "migrate:status": "payload migrate:status",
    "migrate:down": "payload migrate:down",
    "import": "payload run scripts/import/import.ts",
    "crawl": "tsx scripts/crawl/crawl.ts",
    "redirects:map": "tsx scripts/redirects/build-map.ts",
    "seed:paginas": "payload run scripts/import/seed-paginas.ts",
    "db:check": "tsx scripts/db/check-migrations.ts",
    "db:vaciar-solicitudes-preview": "payload run scripts/db/vaciar-solicitudes-preview.ts",
    "preview:hero-prueba": "payload run scripts/portada/hero-prueba-preview.ts",
    "deploy:migrate": "npm run db:check && payload migrate",
    "redirects:check": "payload run scripts/redirects/verificar-destinos.ts",
    "redirects:check:estricto": "REDIRECTS_ESTRICTO=true payload run scripts/redirects/verificar-destinos.ts",
    "backup": "tsx scripts/backup/respaldar.ts",
    "restore": "tsx scripts/backup/restaurar.ts",
    "backup:verify": "tsx scripts/backup/verificar-restauracion.ts",
    "backup:prune": "tsx scripts/backup/podar.ts",
    "backup:blob": "payload run scripts/backup/inventario-blob.ts",
    "qa": "tsx scripts/qa/verificar.ts",
    "qa:acceso-portada": "payload run scripts/qa/verificar-acceso-portada.ts",
    "rol": "payload run scripts/usuarios/asignar-rol.ts",
    "rol:admin": "payload run scripts/usuarios/asignar-rol.ts",
    "prefs:menu": "payload run scripts/usuarios/preferencias-menu.ts",
    "prefs:borrar": "payload run scripts/usuarios/borrar-preferencia.ts",
    "humo": "tsx scripts/qa/humo.ts",
    "qa:vuelo-pie": "npx -y -p puppeteer-core@24.43.1 node scripts/qa/vuelo-pie.mjs"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.89.0",
    "@payloadcms/email-resend": "3.89.0",
    "@payloadcms/next": "3.89.0",
    "@payloadcms/richtext-lexical": "3.89.0",
    "@payloadcms/storage-vercel-blob": "3.89.0",
    "@tabler/icons-react": "^3.46.0",
    "next": "16.3.5",
    "payload": "3.89.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "sass": "1.77.4",
    "tailwindcss": "^4",
    "tsx": "4.22.4",
    "typescript": "^5"
  }
}
